# =============================================================================
# AI Document Search - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Secret key for signing JWTs (REQUIRED: Generate a strong random string for production!)
AUTH_JWT_SECRET=devsecret

# JWT issuer identifier
AUTH_JWT_ISS=rag-app

# Development mode: Skip authentication entirely (1=enabled, 0=disabled)
# WARNING: Set to 0 in production!
DEV_NO_AUTH=1

# -----------------------------------------------------------------------------
# OpenAI API
# -----------------------------------------------------------------------------
# Your OpenAI API key (REQUIRED for embeddings and chat completions)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Model for generating embeddings
EMBED_MODEL=text-embedding-3-small

# Model for chat completions
CHAT_MODEL=gpt-4o-mini

# OpenAI request timeout (seconds)
OPENAI_TIMEOUT_S=45

# OpenAI request retries
OPENAI_RETRIES=3

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# Directory for storing FAISS indexes (per-user: data/index/<user_id>/)
INDEX_DIR=./data/index

# Directory for storing uploaded PDFs (per-user: data/uploads/<user_id>/)
UPLOAD_DIR=./data/uploads

# Maximum PDF file size in MB
MAX_PDF_MB=40

# Maximum number of pages per PDF
MAX_PAGES=2000

# Maximum chunks per document in retrieval results (increased for better context)
MAX_CHUNKS_PER_DOC=5

# Default number of top results to retrieve (increased for more comprehensive answers)
TOP_K_DEFAULT=10

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# Frontend origin for CORS (comma-separated for multiple)
FRONTEND_ORIGIN=http://localhost:3000

# API base URL (used by frontend)
REACT_APP_API_BASE=http://localhost:8000

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
# Rate limit for chat endpoints (requests per minute per user)
RATE_LIMIT_CHAT=20

# -----------------------------------------------------------------------------
# Logging & Telemetry
# -----------------------------------------------------------------------------
# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Enable telemetry event logging (1=enabled, 0=disabled)
TELEMETRY_ENABLED=1

# Directory for storing telemetry logs
TELEMETRY_DIR=./data/logs

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# Host for Uvicorn (0.0.0.0 for Docker, 127.0.0.1 for local)
HOST=0.0.0.0

# Port for backend server
PORT=8000

# Number of Uvicorn workers (use 1 for development)
WORKERS=1

# -----------------------------------------------------------------------------
# Production Deployment
# -----------------------------------------------------------------------------
# For production:
# 1. Set DEV_NO_AUTH=0
# 2. Generate a strong AUTH_JWT_SECRET (32+ random characters)
# 3. Set FRONTEND_ORIGIN to your production domain
# 4. Use a secure OPENAI_API_KEY
# 5. Configure reverse proxy (Nginx) for SSL/TLS
# -----------------------------------------------------------------------------

